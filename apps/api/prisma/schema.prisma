generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum RecordingStatus {
  UPLOADING
  READY
  ERROR
}

model Meeting {
  id              String           @id @default(uuid())
  title           String
  createdAt       DateTime         @default(now())
  recordingKey    String?
  recordingStatus RecordingStatus?
  recordingError  String?
}
